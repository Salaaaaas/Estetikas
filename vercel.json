{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/send-reminders",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/register-calendar-watch",
      "schedule": "0 6 */6 * *"
    }
  ]
}
