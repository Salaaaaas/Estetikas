# ============================================================
# Esteti'Kas — Variables de entorno
# Copia este archivo a `.env` para desarrollo local
# En producción configura todas estas variables en:
#   Netlify Dashboard → Site Settings → Environment Variables
# ============================================================

# ---------- Supabase ----------
# Dashboard → Project Settings → API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...           # NUNCA exponer al cliente

# ---------- Cifrado de PII ----------
# Genera con: openssl rand -base64 48
# Guárdala en un gestor de contraseñas. Si la pierdes, los teléfonos
# y emails almacenados quedan irrecuperables.
PII_ENCRYPTION_KEY=cambia-esto-por-una-clave-larga-y-aleatoria-min-32-chars

# ---------- Cloudflare Turnstile (CAPTCHA gratis) ----------
# Crea sitio en: https://dash.cloudflare.com/?to=/:account/turnstile
# Modo: Managed o Invisible
PUBLIC_TURNSTILE_SITEKEY=0x4AAAAAAA...             # visible (cliente)
TURNSTILE_SECRET_KEY=0x4AAAAAAA...                 # privada (backend)

# ---------- Email transaccional (Resend) ----------
# Dashboard → API Keys: https://resend.com/api-keys
RESEND_API_KEY=re_...

# ---------- Cron de recordatorios (Vercel Cron) ----------
# Secreto que debe enviar el cron en el header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# ---------- Google Calendar ----------
# Estos nombres deben coincidir EXACTAMENTE con los que usa el código en api/_lib/calendar.mjs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ---------- Sincronización Google Calendar → sitio (webhook) ----------
# Token que valida las notificaciones push entrantes de Google Calendar
CALENDAR_WEBHOOK_TOKEN=cambia-esto-por-un-token-aleatorio
# URL pública base del sitio para registrar el canal de notificaciones (sin slash final)
WEBHOOK_BASE_URL=https://estetikas.vercel.app

# ---------- Fase 4 (WhatsApp Cloud API) ----------
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=

# ---------- App móvil: índice buscable del teléfono ----------
# HMAC con el que se calcula citas.telefono_hash. Es SEPARADA de
# PII_ENCRYPTION_KEY a propósito. Genera con: openssl rand -base64 48
# Si la cambias, hay que volver a correr scripts/backfill-telefono-hash.mjs.
PHONE_HASH_PEPPER=cambia-esto-por-un-pepper-largo-y-aleatorio-min-32-chars

# ---------- App móvil: retos y sesiones ----------
# Firma los retos de atestación y los tokens de sesión de la app.
# Genera con: openssl rand -base64 48
# Rotarla invalida todas las sesiones: las apps vuelven a atestar solas.
MOBILE_SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-min-32-chars

# ---------- App móvil: App Attest (iOS) ----------
# Team ID en https://developer.apple.com/account → Membership
APPLE_TEAM_ID=
IOS_BUNDLE_ID=cr.estetikas.app
# "development" solo para probar con builds de Xcode. En producción déjala
# vacía o en "production": si no, se aceptan atestaciones de desarrollo.
APP_ATTEST_ENV=production

# ---------- App móvil: Play Integrity (Android) ----------
ANDROID_PACKAGE_NAME=cr.estetikas.app
# JSON de la cuenta de servicio con el rol de Play Integrity, tal cual o en
# base64 (más cómodo de pegar en Vercel).
GOOGLE_PLAY_INTEGRITY_SA_JSON=
