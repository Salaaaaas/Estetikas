---
import BaseLayout from './BaseLayout.astro';
import { WA_URL } from '../data/clinic';

interface Props {
  /** id del tratamiento (slug), clave en el carrito */
  id: string;
  title: string;
  description: string;
  heroImage: string;
  heroAlt: string;
  heroPosition?: string;
  heroTitle: string;
  heroSubtitle: string;
  cartName: string;
}

const { id, title, description, heroImage, heroAlt, heroPosition = 'center', heroTitle, heroSubtitle, cartName } = Astro.props;
const waHref = `${WA_URL}?text=${encodeURIComponent(`Hola, me gustaría solicitar información sobre el tratamiento de ${heroTitle}.`)}`;
---

<BaseLayout
  title={`${title} | Esteti'Kas`}
  description={description}
  footerVariant="simple"
  ogImage={`/img/${heroImage}`}
>
  <!-- Hero dividido como el del inicio: la foto se muestra entera en su proporción, sin estirarla a lo ancho -->
  <section
    class="grid grid-cols-[1.1fr_1fr] items-center gap-[6%] bg-[radial-gradient(ellipse_60%_50%_at_85%_15%,rgba(0,125,136,.10)_0%,transparent_70%),radial-gradient(ellipse_55%_45%_at_10%_85%,rgba(201,168,76,.08)_0%,transparent_70%)] px-[8%] pt-[calc(15vh+2rem)] pb-16 max-desk:grid-cols-1 max-desk:gap-10 max-desk:text-center max-md:px-[5%] max-md:pt-32"
  >
    <div class="flex flex-col max-desk:items-center">
      <a href="/tratamientos" class="mb-6 inline-flex items-center gap-2 text-[0.8rem] font-medium uppercase tracking-[2px] text-primary no-underline hover:underline">
        <span class="w-9 h-0.5 bg-gold" aria-hidden="true"></span>
        Tratamientos
      </a>
      <h1 class="font-heading font-bold text-ink text-[clamp(2.5rem,4.6vw,4rem)] leading-[1.08] tracking-[-1px] mb-6">{heroTitle}</h1>
      <p class="text-[1.15rem] leading-[1.7] font-light text-muted max-w-[46ch] mb-10">{heroSubtitle}</p>
      <div class="flex flex-wrap items-center gap-4 max-desk:justify-center">
        <a href="/reservar" class="btn">Reservar cita</a>
        <a href={waHref} class="btn btn-outline-dark" target="_blank" rel="noopener noreferrer">Consultar por WhatsApp</a>
      </div>
    </div>
    <div class="w-full max-w-[520px] justify-self-end aspect-[4/5] max-h-[min(640px,72vh)] rounded-[28px] overflow-hidden ring-1 ring-white/60 shadow-[0_24px_60px_rgba(0,60,66,0.16)] max-desk:justify-self-center max-desk:max-w-[440px] max-md:aspect-[4/3.6]">
      <img
        class="block size-full object-cover"
        style={`object-position: ${heroPosition}`}
        src={`/img/${heroImage}`}
        alt={heroAlt}
        width="800"
        height="1000"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </section>

  <section class="bg-surface bg-[radial-gradient(ellipse_60%_40%_at_90%_10%,rgba(0,125,136,.08)_0%,transparent_70%),radial-gradient(ellipse_50%_40%_at_5%_90%,rgba(201,168,76,.07)_0%,transparent_70%)] px-[8%] py-24 max-md:px-[5%] max-md:py-16">
    <div class="max-w-[900px] mx-auto">
      <slot />

      <div class="glass text-center p-16 rounded-[32px] bg-[radial-gradient(ellipse_70%_80%_at_50%_0%,rgba(0,125,136,.10)_0%,transparent_70%)] max-md:p-8">
        <h3 class="text-[2rem] font-bold text-primary mb-4">¿Te interesa este tratamiento?</h3>
        <p class="text-muted mb-8">Haz clic en el botón debajo para consultarnos directamente por WhatsApp sobre disponibilidad, precios, o cualquier duda que tengas.</p>
        <a href={waHref} class="btn" target="_blank" rel="noopener noreferrer">Preguntar por WhatsApp</a> <button
          type="button"
          data-add-to-cart
          data-cart-id={id}
          data-cart-name={cartName}
          class="btn group mt-4 data-added:bg-[#1E7B34]! data-added:border-[#1E7B34]!"
        >
          <span class="contents group-data-added:hidden">
            <svg class="mr-2 align-middle" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
            Agregar a Mi Lista de Citas
          </span>
          <span class="hidden group-data-added:contents">
            <svg class="mr-2 align-middle" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
            Agregado a tu lista
          </span>
        </button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/cart-buttons';
</script>
