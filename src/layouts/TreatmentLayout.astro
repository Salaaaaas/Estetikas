---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  heroImage: string;
  heroAlt: string;
  heroTitle: string;
  heroSubtitle: string;
  cartName: string;
}

const { title, description, heroImage, heroAlt, heroTitle, heroSubtitle, cartName } = Astro.props;
---

<BaseLayout
  title={`${title} | Esteti'Kas`}
  description={description}
  footerVariant="simple"
  bodyClass="dark-hero"
  ogImage={`/img/${heroImage}`}
>
  <section class="treatment-detail-hero">
    <img class="hero-bg-image" src={`/img/${heroImage}`} alt={heroAlt} loading="eager" fetchpriority="high" />
    <div class="wrapper">
      <h1>{heroTitle}</h1>
      <p>{heroSubtitle}</p>
    </div>
  </section>

  <section class="treatment-detail-content">
    <div class="content-wrapper">
      <slot />

      <div class="whatsapp-cta-container trigger-reveal" data-cart-name={cartName}>
        <h3>¿Te interesa este tratamiento?</h3>
        <p>Haz clic en el botón debajo para consultarnos directamente por WhatsApp sobre disponibilidad, precios, o cualquier duda que tengas.</p>
        <a
          href={`https://wa.me/50684320647?text=${encodeURIComponent(`Hola, me gustaría solicitar información sobre el tratamiento de ${heroTitle}.`)}`}
          class="btn"
          target="_blank"
          rel="noopener noreferrer"
        >
          Preguntar por WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
