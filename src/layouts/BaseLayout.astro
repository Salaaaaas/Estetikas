---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/style.css';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  isHome?: boolean;
}

const {
  title,
  description = "Esteti'Kas: Clínica de medicina estética avanzada en Bataan y Guápiles, Costa Rica.",
  bodyClass = '',
  isHome = false,
} = Astro.props;

const turnstileSitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? '';
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" href="/img/logo_turquesa.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="turnstile-sitekey" content={turnstileSitekey} />

  <!-- Cloudflare Turnstile (CAPTCHA invisible) -->
  <script
    src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onTurnstileLoad"
    async
    defer
    is:inline
  ></script>
  <script is:inline>
    window.onTurnstileLoad = function () {
      window.dispatchEvent(new Event('turnstile-loaded'));
    };
  </script>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload"
    href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500&family=Playfair+Display:wght@400;700&display=swap"
    as="style"
    onload="this.onload=null;this.rel='stylesheet'"
  />
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet" />
  </noscript>

</head>
<body class={bodyClass}>
  <Header isHome={isHome} />

  <main>
    <slot />
  </main>

  <Footer variant="full" />

  <script>
    import '../scripts/site.js';
  </script>
</body>
</html>
