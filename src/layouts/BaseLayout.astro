---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/style.css';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  isHome?: boolean;
  footerVariant?: 'full' | 'simple';
  needsTurnstile?: boolean;
  ogImage?: string;
}

const {
  title,
  description = "Esteti'Kas: Clínica de medicina estética avanzada en Bataan y Guápiles, Costa Rica.",
  bodyClass = '',
  isHome = false,
  footerVariant = 'full',
  needsTurnstile = false,
  ogImage = '/img/facial.webp',
} = Astro.props;

const turnstileSitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? '';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#007D88" />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(ogImage, Astro.site)} />
  <meta property="og:locale" content="es_CR" />

  {needsTurnstile && (
    <>
      <meta name="turnstile-sitekey" content={turnstileSitekey} />
      <!-- Cloudflare Turnstile (CAPTCHA invisible) — solo en /reservar -->
      <script
        src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onTurnstileLoad"
        async
        defer
        is:inline
      ></script>
      <script is:inline>
        window.onTurnstileLoad = function () {
          window.dispatchEvent(new Event('turnstile-loaded'));
        };
      </script>
    </>
  )}

  <!-- Fonts: async load to avoid render-blocking -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" media="print" onload="this.media='all'" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,700;1,6..96,400;1,6..96,700&family=Jost:wght@300;400;500;600&display=swap">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,700;1,6..96,400;1,6..96,700&family=Jost:wght@300;400;500;600&display=swap"></noscript>

  {isHome && <link rel="preload" as="image" href="/img/facial.webp" fetchpriority="high" />}

</head>
<body class={bodyClass}>
  <Header isHome={isHome} />

  <main>
    <slot />
  </main>

  <Footer variant={footerVariant} />

  <script>
    import '../scripts/site.js';
  </script>
</body>
</html>
