---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import TrustBar from '../components/home/TrustBar.astro';
import TreatmentsMarquee from '../components/home/TreatmentsMarquee.astro';
import Team from '../components/home/Team.astro';
import Philosophy from '../components/home/Philosophy.astro';
import Specialties from '../components/home/Specialties.astro';
import CareSection from '../components/home/CareSection.astro';
import FaqSection from '../components/home/FaqSection.astro';
import ContactSection from '../components/home/ContactSection.astro';
---

<BaseLayout
  title="Esteti'Kas | Medicina Estética en Guápiles y Bataan"
  description="Clínica de medicina estética en Guápiles y Bataan, Costa Rica. Botox, rellenos, limpiezas faciales, bioestimuladores y tratamientos corporales con médicas certificadas. Reserva en línea."
  bodyClass="home-page"
  isHome={true}
>
  <Hero />
  <TrustBar />
  <TreatmentsMarquee />
  <Team />
  <Philosophy />
  <Specialties />
  <CareSection />
  <FaqSection />
  <ContactSection />
</BaseLayout>
