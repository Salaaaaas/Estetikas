---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import TrustBar from '../components/home/TrustBar.astro';
import TreatmentsMarquee from '../components/home/TreatmentsMarquee.astro';
import Team from '../components/home/Team.astro';
import Philosophy from '../components/home/Philosophy.astro';
import Specialties from '../components/home/Specialties.astro';
import CareSection from '../components/home/CareSection.astro';
import Testimonials from '../components/home/Testimonials.astro';
import FaqSection from '../components/home/FaqSection.astro';
import ContactSection from '../components/home/ContactSection.astro';
---

<BaseLayout
  title="Esteti'Kas | Medicina, Salud & Belleza"
  description="Esteti'Kas: Clínica de medicina estética avanzada con 3 sedes en Bataan y Guápiles, Costa Rica. Tu aliado en el cuidado integral."
  bodyClass="home-page"
  isHome={true}
>
  <Hero />
  <TrustBar />
  <TreatmentsMarquee />
  <Team />
  <Philosophy />
  <Specialties />
  <CareSection />
  <Testimonials />
  <FaqSection />
  <ContactSection />
</BaseLayout>
