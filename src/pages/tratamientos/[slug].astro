---
import { getCollection } from 'astro:content';
import TreatmentLayout from '../../layouts/TreatmentLayout.astro';

export async function getStaticPaths() {
  const treatments = await getCollection('tratamientos');
  return treatments.map((t) => ({
    params: { slug: t.id },
    props: { treatment: t },
  }));
}

const { treatment } = Astro.props;
const { title, description, heroImage, heroAlt, heroPosition, subtitle, about, benefits, indications, sessions, aftercare, contraindications, prices, cartName } = treatment.data;

const listItem = 'relative pl-6 mb-3 text-[1.02rem] leading-[1.55] text-muted before:content-[\'\'] before:absolute before:left-0 before:top-[0.6em] before:size-[7px] before:rounded-full before:bg-primary/70';
---

<TreatmentLayout
  id={treatment.id}
  title={title}
  description={description}
  heroImage={heroImage}
  heroAlt={heroAlt}
  heroPosition={heroPosition}
  heroTitle={title}
  heroSubtitle={subtitle}
  cartName={cartName}
>
  <div class="mb-16">
    <h2 class="text-[2rem] font-bold text-ink mb-6">Acerca de este tratamiento</h2>
    <p class="text-[1.1rem] leading-[1.8] text-muted">{about}</p>
  </div>

  <div class="glass mb-16 p-12 rounded-[28px] max-md:p-8">
    <h2 class="text-[1.8rem] font-bold mb-8">Beneficios y Resultados</h2>
    <ul class="list-none p-0">
      {benefits.map((b) => (
        <li class="flex items-start gap-4 mb-[1.2rem] text-[1.05rem] leading-[1.4] text-ink">
          <svg class="shrink-0 mt-[3px]" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
          <span>{b}</span>
        </li>
      ))}
    </ul>
  </div>

  {(indications || sessions) && (
    <div class="mb-16">
      <h2 class="text-[1.8rem] font-bold text-ink mb-6">¿Para quién es?</h2>
      {indications && (
        <ul class="list-none p-0 mb-6">
          {indications.map((i) => <li class={listItem}>{i}</li>)}
        </ul>
      )}
      {sessions && <p class="text-[1.02rem] leading-[1.7] text-ink"><strong class="font-semibold">Sesiones:</strong> {sessions}</p>}
    </div>
  )}

  {aftercare && (
    <div class="glass mb-16 p-12 rounded-[28px] max-md:p-8">
      <h2 class="text-[1.8rem] font-bold mb-6">Cuidados después del tratamiento</h2>
      <ul class="list-none p-0">
        {aftercare.map((a) => <li class={listItem}>{a}</li>)}
      </ul>
    </div>
  )}

  {contraindications && (
    <div class="mb-16">
      <h2 class="text-[1.8rem] font-bold text-ink mb-3">Contraindicaciones</h2>
      <p class="text-[0.95rem] text-muted mb-6">La valoración médica previa confirma si el tratamiento es adecuado para ti.</p>
      <ul class="list-none p-0">
        {contraindications.map((c) => <li class={listItem}>{c}</li>)}
      </ul>
    </div>
  )}

  {prices && prices.length > 0 && (
    <div class="mb-16">
      <h2 class="text-[1.8rem] font-bold text-ink mb-8">Precios</h2>
      <ul class="list-none p-0">
        {prices.map((p) => (
          <li class="flex flex-wrap items-baseline gap-4 py-4 border-b border-black/7 last:border-b-0">
            <span class="flex-1 text-[1rem] font-normal text-ink">{p.label}</span>
            <span class="text-[1.1rem] font-semibold text-primary whitespace-nowrap">{p.price}</span>
            {p.note && <span class="w-full text-[0.85rem] text-muted mt-[0.2rem]">{p.note}</span>}
          </li>
        ))}
      </ul>
    </div>
  )}
</TreatmentLayout>
