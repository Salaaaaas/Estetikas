---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TreatmentsHero from '../components/treatments/TreatmentsHero.astro';
import CategorySection from '../components/treatments/CategorySection.astro';
import TreatmentsCta from '../components/treatments/TreatmentsCta.astro';
import { TREATMENT_CATEGORIES } from '../data/treatments';

const all = await getCollection('tratamientos');

const byCategory = TREATMENT_CATEGORIES.map((cat) => {
  const items = all.filter((t) => t.data.category === cat.name);
  // La destacada va primero; el resto conserva su orden
  items.sort((a, b) => (a.id === cat.featured ? -1 : b.id === cat.featured ? 1 : 0));
  return { ...cat, items };
});

const totalCount = all.length;
---

<BaseLayout
  title="Tratamientos | Esteti'Kas"
  description={`${totalCount} tratamientos de medicina estética para rostro, cuerpo y bienestar en Bataan y Guápiles, Costa Rica.`}
  bodyClass="dark-hero"
>
  <TreatmentsHero
    totalCount={totalCount}
    categories={byCategory.map(({ name, slug, items }) => ({ name, slug, count: items.length }))}
  />

  {byCategory.map(({ name, slug, desc, items }, i) => (
    <CategorySection name={name} slug={slug} desc={desc} items={items} alt={i % 2 === 1} />
  ))}

  <TreatmentsCta />
</BaseLayout>
