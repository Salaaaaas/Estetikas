---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingForm from '../components/booking/BookingForm';
---

<BaseLayout
  title="Reservar Cita | Esteti'Kas"
  description="Reserva tu cita de medicina estética en Esteti'Kas. Completa tus datos y confirmamos por WhatsApp."
  hideCartButton={true}
  needsTurnstile={true}
>
  <section class="bg-surface bg-[radial-gradient(ellipse_55%_45%_at_85%_10%,rgba(0,125,136,.14)_0%,transparent_70%),radial-gradient(ellipse_50%_45%_at_10%_80%,rgba(201,168,76,.10)_0%,transparent_70%)] min-h-dvh px-[clamp(1rem,4vw,2rem)] pt-[clamp(7rem,12vw,9rem)] pb-20 max-ph:px-0 max-ph:pt-32 max-ph:pb-8">
    <div class="glass-strong max-w-[680px] mx-auto rounded-[32px] p-[clamp(1.75rem,4vw,3rem)] max-ph:rounded-[24px] max-ph:mx-3 max-ph:p-5">
      <a href="/" class="group inline-flex items-center gap-[0.4rem] mb-6 text-[0.85rem] font-medium text-muted no-underline transition-colors duration-200 ease-out hover:text-primary" data-back>
        <svg class="transition-[translate] duration-200 ease-out group-hover:-translate-x-[2px]" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>
        Volver
      </a>

      <div class="mb-8 pb-7 border-b-2 border-black/6">
        <span class="inline-flex items-center gap-[0.4rem] mb-2 text-[0.7rem] font-semibold uppercase tracking-[0.08em] text-primary before:content-[''] before:inline-block before:size-[5px] before:shrink-0 before:rounded-full before:bg-primary">Esteti'Kas</span>
        <h1 class="font-heading font-bold text-ink text-[clamp(1.9rem,4.5vw,2.6rem)] tracking-[-0.03em] leading-[1.05] mb-2 max-ph:text-[1.7rem]">Reservar Cita</h1>
        <p class="text-muted text-[1rem] font-normal leading-[1.5] max-w-[52ch] max-ph:text-[0.92rem]">Completa el formulario y te contactamos por WhatsApp para confirmar tu cita.</p>
      </div>

      <BookingForm client:load />
    </div>
  </section>
</BaseLayout>

<script>
  // "Volver": regresa en el historial si lo hay; si no, sigue el enlace al inicio
  document.querySelectorAll<HTMLAnchorElement>('[data-back]').forEach((el) => {
    el.addEventListener('click', (e) => {
      if (window.history.length > 1) {
        e.preventDefault();
        window.history.back();
      }
    });
  });
</script>
