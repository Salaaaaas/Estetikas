---
import type { CollectionEntry } from 'astro:content';
import ArrowIcon from '../icons/ArrowIcon.astro';

interface Props {
  treatment: CollectionEntry<'tratamientos'>;
  /** Tarjeta destacada: ocupa todo el ancho, imagen a la izquierda */
  featured?: boolean;
}

const { treatment: t, featured = false } = Astro.props;
const href = `/tratamientos/${t.id}`;
---

<!-- t-card: gancho del reveal de site.js; t-card-title-link: enlace estirado a toda la tarjeta -->
<article
  class:list={[
    't-card glass group relative flex flex-col overflow-hidden rounded-[24px]',
    'transition-[translate,box-shadow,border-color] duration-240 ease-out motion-reduce:transition-none',
    'hover-fine:-translate-y-1 hover-fine:shadow-[inset_0_1px_0_rgba(255,255,255,0.9),0_20px_44px_-12px_rgba(0,96,104,0.22)]',
    'has-[.t-card-title-link:focus-visible]:outline-2 has-[.t-card-title-link:focus-visible]:outline-primary has-[.t-card-title-link:focus-visible]:outline-offset-3',
    featured && 'col-span-full grid grid-cols-[1.15fr_1fr] max-md:grid-cols-1',
  ]}
>
  <div class:list={['overflow-hidden', featured && 'relative min-h-[340px] max-md:static max-md:min-h-0']}>
    <img
      src={`/img/${t.data.cardImage}`}
      alt={t.data.cardImageAlt}
      width="400"
      height="250"
      loading={t.data.cardLoading}
      decoding="async"
      class:list={[
        'block w-full h-[230px] object-cover transition-[scale] duration-[450ms] ease-out group-hover:scale-105',
        featured && 'absolute inset-0 h-full max-md:static max-md:h-[230px]',
      ]}
    />
  </div>
  <div class:list={['flex flex-1 flex-col', featured ? 'justify-center gap-7 p-[clamp(2rem,4vw,3.25rem)]' : 'justify-between gap-5 px-7 pt-7 pb-6']}>
    <div>
      <h3 class:list={[
        'text-ink',
        featured
          ? 'font-heading font-normal text-[clamp(1.7rem,2.6vw,2.2rem)] tracking-[-0.5px] leading-[1.3] mb-[0.9rem]'
          : 'text-[1.2rem] font-medium leading-[1.3] mb-[0.6rem]',
      ]}>
        <a href={href} class="t-card-title-link font-body text-inherit no-underline after:content-[''] after:absolute after:inset-0 after:z-1">{t.data.cardTitle}</a>
      </h3>
      <p class:list={['font-light text-muted', featured ? 'text-[1.02rem] leading-[1.7] max-w-[48ch]' : 'text-[0.95rem] leading-[1.6]']}>
        {featured ? t.data.about : t.data.cardDescription}
      </p>
    </div>
    <div class="relative z-2 mt-auto flex items-center justify-between gap-3 pointer-events-none">
      <a href={href} class="inline-flex items-center gap-[5px] text-primary text-[0.9rem] font-medium no-underline pointer-events-auto transition-[gap] duration-200 ease-out group-hover:gap-[9px]">
        Leer más
        <ArrowIcon />
      </a>
      <button
        type="button"
        data-add-to-cart
        data-cart-id={t.id}
        data-cart-name={t.data.cartName}
        class="group/btn reserve-btn glass-sheen flex shrink-0 items-center gap-[5px] rounded-full border border-primary bg-primary px-4 py-[0.55rem] font-body text-[0.78rem] font-medium tracking-[0.5px] text-white cursor-pointer pointer-events-auto transition-[background-color,translate] duration-200 ease-out motion-reduce:transition-none hover:bg-primary-hover hover:border-primary-hover hover-fine:-translate-y-0.5 active:translate-y-px data-added:pointer-events-none data-added:border-[#1E7B34] data-added:bg-[#1E7B34]"
      >
        <span class="contents group-data-added/btn:hidden">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
          Reservar
        </span>
        <span class="hidden group-data-added/btn:contents">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
          Agregado
        </span>
      </button>
    </div>
  </div>
</article>

<script>
  import '../../scripts/cart-buttons';
</script>
