---
interface Props {
  variant?: 'full' | 'simple';
}

const { variant = 'full' } = Astro.props;
const year = new Date().getFullYear();

const treatments = [
  { label: 'Limpieza Facial', href: '/tratamientos/limpieza-facial' },
  { label: 'Peelings', href: '/tratamientos/peelings' },
  { label: 'Botox & Rellenos', href: '/tratamientos/rellenos' },
  { label: 'Sueroterapia', href: '/tratamientos/sueroterapia' },
  { label: 'Masajes', href: '/tratamientos/masajes' },
  { label: 'Ver todos →', href: '/tratamientos' },
];

const sedes = [
  { label: 'Bataan — ODONTOBATAAN', href: 'https://www.google.com/maps/search/?api=1&query=Cl%C3%ADnica+ODONTOBATAAN+Bataan+Lim%C3%B3n+Costa+Rica' },
  { label: 'Guápiles — Medical Numancia', href: 'https://www.google.com/maps/search/?api=1&query=Cl%C3%ADnica+Medical+Numancia+Gu%C3%A1piles+Costa+Rica' },
  { label: 'Guápiles — Eco Clinic', href: 'https://maps.app.goo.gl/8k4cr7GRKfzPFY3u9?g_st=ic' },
];

const footerBase =
  'bg-ink text-white text-center px-[8%] pt-16 pb-8 text-[0.9rem] font-light tracking-[1px] border-t border-white/5';
const colTitle = 'text-[0.78rem] font-bold uppercase tracking-[2px] text-white/45 mb-[1.2rem]';
const colLink = 'text-white/70 no-underline text-[0.9rem] font-light transition-colors duration-200 hover:text-primary-on-dark';
const socialLink = 'text-white/45 transition-colors duration-200 hover:text-primary-on-dark';
---

{variant === 'full' ? (
<footer class={footerBase}>
  <div class="grid grid-cols-[2fr_1fr_1fr] gap-12 max-w-[1100px] mx-auto mb-12 text-left max-md:grid-cols-1 max-md:gap-8 max-md:text-center">
    <div>
      <img src="/img/logo_nav.webp" alt="Esteti'Kas" width="152" height="200" loading="lazy" decoding="async" class="block h-[55px] w-auto opacity-85 mb-4 brightness-120 max-md:mx-auto" />
      <p class="text-white/55 text-[0.88rem] font-light leading-[1.7]">Clínica de medicina estética avanzada. Procedimientos personalizados a cargo de profesionales de la salud en Bataan y Guápiles, Costa Rica.</p>
    </div>
    <div>
      <h3 class={colTitle}>Tratamientos</h3>
      <ul class="list-none p-0">
        {treatments.map((t) => (
          <li class="mb-[0.65rem]"><a href={t.href} class={colLink}>{t.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h3 class={colTitle}>Contacto</h3>
      <ul class="list-none p-0">
        <li class="mb-[0.65rem]"><a href="https://wa.me/50684320647" class={colLink}>+506 8432 0647</a></li>
        <li class="mb-[0.65rem]"><a href="https://www.instagram.com/esteti_kas/" target="_blank" rel="noopener" class={colLink}>@esteti_kas</a></li>
        <li class="mb-[0.65rem]"><a href="/#contacto" class={colLink}>Formulario de contacto</a></li>
      </ul>
      <h3 class:list={[colTitle, 'mt-6']}>Sedes</h3>
      <ul class="list-none p-0">
        {sedes.map((s) => (
          <li class="mb-[0.65rem]"><a href={s.href} target="_blank" rel="noopener" class={colLink}>{s.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="flex flex-wrap justify-between items-center gap-4 max-w-[1100px] mx-auto pt-8 border-t border-white/6 max-md:justify-center max-md:text-center">
    <p class="text-[0.82rem] text-white/60 font-light">&copy; {year} Esteti'Kas Medicina, Salud & Belleza. Todos los derechos reservados.</p>
    <div class="flex gap-4">
      <a href="https://wa.me/50684320647" aria-label="WhatsApp" class={socialLink}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      </a>
      <a href="https://www.instagram.com/esteti_kas/" target="_blank" rel="noopener" aria-label="Instagram" class={socialLink}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
      </a>
    </div>
  </div>
</footer>
) : (
<footer class={footerBase}>
  <div class="max-w-[1200px] mx-auto flex flex-col items-center gap-8">
    <div>
      <img src="/img/logo_nav.webp" alt="Esteti'Kas" width="152" height="200" loading="lazy" decoding="async" class="block h-[60px] w-auto opacity-80 brightness-120 mb-6 transition-opacity duration-200 ease-out hover:opacity-100" />
    </div>
    <div>
      <p class="text-[0.9rem] opacity-70 font-light max-w-[600px] mx-auto">&copy; {year} Esteti'Kas Medicina, Salud & Belleza. Dra. Karen Mayorga Quirós y Katherine Leitón Castillo. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
)}
