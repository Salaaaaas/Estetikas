---
// Encabezado de sección alineado a la izquierda con su contenido.
interface Props {
  title: string;
  tag?: string;
  /** Clase de ancho máximo opcional */
  maxWidth?: string;
}

const { title, tag, maxWidth } = Astro.props;
---

<div class:list={['text-center mb-16', maxWidth]}>
  {tag && <span class="inline-block mb-3 text-primary text-[0.85rem] font-medium tracking-normal">{tag}</span>}
  <h2 class="font-heading font-normal text-ink text-[clamp(2rem,3.5vw,2.8rem)] tracking-[-0.5px] mb-4 text-balance max-tab:text-[2.2rem]">{title}</h2>
</div>
