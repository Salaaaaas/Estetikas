---
import FaqAccordion from './FaqAccordion';
import SectionHeader from './SectionHeader.astro';
import { FAQ } from '../../data/home';
---

<section id="faq" class="bg-white bg-[radial-gradient(ellipse_60%_50%_at_85%_15%,rgba(0,125,136,.10)_0%,transparent_70%),radial-gradient(ellipse_55%_45%_at_10%_85%,rgba(201,168,76,.08)_0%,transparent_70%)] px-[5%] py-28">
  <SectionHeader title="Preguntas Frecuentes" />
  <div class="glass max-w-[830px] mx-auto rounded-[32px] px-10 py-4 max-md:px-6">
    <FaqAccordion client:visible items={FAQ} />
  </div>
</section>
