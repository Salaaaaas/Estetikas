---
import CareTabs from './CareTabs';
import { CARE_PROTOCOLS } from '../../data/home';
---

<section
  id="cuidados"
  class="relative overflow-hidden px-[5%] py-32 border-t border-[rgba(0,166,178,0.05)] bg-[radial-gradient(ellipse_45%_55%_at_20%_60%,rgba(0,125,136,.16)_0%,transparent_70%),radial-gradient(ellipse_40%_50%_at_85%_40%,rgba(201,168,76,.12)_0%,transparent_70%),linear-gradient(135deg,rgba(235,248,249,1)_0%,rgba(255,255,255,1)_100%)]"
>
  <div class="max-w-[1200px] mx-auto mb-16 text-center">
    <h2 class="font-heading font-normal text-ink text-[clamp(1.8rem,3vw,2.4rem)] tracking-[-0.5px] mb-3 max-md:text-[1.8rem] max-md:mb-8">Cuidados Post-Tratamiento</h2>
    <p class="text-muted text-[1rem] font-light">Lo que haces en casa después de tu cita cuenta tanto como el tratamiento.</p>
  </div>
  <CareTabs client:visible protocols={CARE_PROTOCOLS} />
</section>
