---
// Hero editorial dividido. Las clases hero-* son ganchos de animación (site.js).
---

<section
  id="inicio"
  class="hero grid grid-cols-2 min-h-[92vh] bg-[radial-gradient(ellipse_60%_50%_at_85%_15%,rgba(0,125,136,.10)_0%,transparent_70%),radial-gradient(ellipse_55%_45%_at_10%_85%,rgba(201,168,76,.08)_0%,transparent_70%)] px-[8%] pt-[15vh] pb-0 overflow-hidden max-desk:grid-cols-1 max-desk:min-h-0 max-desk:pb-20 max-desk:text-center"
>
  <div class="hero-content flex flex-col justify-center pt-32 pr-[6%] pb-24 pl-0 max-desk:p-0 max-desk:items-center max-desk:order-1">
    <div class="hero-eyemark w-9 h-0.5 bg-gold mb-8 max-desk:mx-auto max-desk:mb-6" aria-hidden="true"></div>
    <h1
      class="hero-display font-heading font-bold text-ink text-[clamp(4rem,8vw,8.5rem)] leading-[0.88] tracking-[-3px] mb-12 max-desk:text-[clamp(3.5rem,10vw,6rem)] max-desk:tracking-[-2px] max-desk:text-center"
    >
      <em class="block font-body italic font-normal text-primary">Medicina</em>
      <span class="block font-body">Estética</span>
      <span class="block font-body">Avanzada</span>
    </h1>
    <div class="hero-bottom flex flex-col gap-8 max-desk:items-center">
      <p class="text-[1.1rem] leading-[1.7] font-light text-muted max-w-[500px] mb-10 max-desk:text-center">
        Tratamientos faciales y corporales con médicas y especialistas certificadas.<br>Resultados naturales en Bataan y Guápiles.
      </p>
      <div class="flex flex-wrap items-center gap-4 max-desk:justify-center">
        <a href="#contacto" class="btn">Agendar Valoración</a>
        <a href="/tratamientos" class="btn btn-outline-dark">Ver Tratamientos</a>
      </div>
    </div>
  </div>
  <div
    class="hero-image-wrap group w-full self-center rounded-[28px] overflow-hidden ring-1 ring-white/60 shadow-[0_24px_60px_rgba(0,60,66,0.16)] h-[min(640px,70vh)] max-desk:order-2 max-desk:h-[50vh] max-desk:mt-12 max-md:h-[40vh] max-xs:h-[300px] max-xs:rounded-[2px]"
  >
    <img
      class="hero-image block w-full h-full object-cover object-center transition-transform duration-[600ms] ease-out motion-safe:group-hover:scale-[1.03]"
      src="/img/hero-facial.webp"
      alt="Paciente recibiendo una limpieza facial con vapor en Esteti'Kas"
      loading="eager"
      fetchpriority="high"
      width="1200"
      height="1200"
    />
  </div>
</section>
