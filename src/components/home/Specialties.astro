---
import { SPECIALTIES } from '../../data/home';
// specialties-*/specialty-card: ganchos de animación de site.js.
---

<section
  id="especialidades"
  class="grid grid-cols-2 gap-[8%] min-h-dvh px-[8%] bg-surface bg-[radial-gradient(ellipse_80%_60%_at_20%_50%,rgba(0,125,136,.06)_0%,transparent_100%),radial-gradient(ellipse_60%_50%_at_80%_30%,rgba(201,168,76,.04)_0%,transparent_100%)] max-tab:grid-cols-1 max-tab:min-h-0 max-tab:gap-0 max-tab:py-20"
>
  <div class="relative">
    <div class="sticky top-[28vh] pt-28 pb-16 max-tab:relative max-tab:top-auto max-tab:pt-0 max-tab:pb-12">
      <div class="specialties-count font-heading font-normal text-primary text-[clamp(4rem,6vw,6.5rem)] tracking-[-3px] leading-[0.85] mb-6 max-tab:text-[3.5rem]" aria-hidden="true">3</div>
      <h2 class="specialties-heading font-heading font-normal text-ink text-[clamp(2.5rem,4vw,4.2rem)] leading-none tracking-[-1.5px] mb-5">
        Nuestras<br>Especialidades
      </h2>
      <p class="specialties-sub text-[0.93rem] leading-[1.7] text-muted max-w-[34ch] mb-10">Tratamientos para rostro, cuerpo y bienestar, con respaldo médico.</p>
      <a href="/tratamientos" class="specialties-cta btn">Ver todos los tratamientos</a>
    </div>
  </div>
  <div class="flex flex-col gap-6 pt-40 pb-32 max-tab:pt-0 max-tab:pb-16">
    {SPECIALTIES.map((specialty) => (
      <div
        class:list={[
          'specialty-card glass group relative overflow-hidden flex flex-col items-start text-left cursor-default px-8 py-10 rounded-[28px]',
          'transition-[translate,box-shadow] duration-300 ease-out motion-reduce:transition-none hover-fine:-translate-y-1 hover-fine:shadow-[inset_0_1px_0_rgba(255,255,255,0.9),0_20px_44px_-12px_rgba(0,96,104,0.22)]',
          // Halo radial que aparece al pasar el cursor
          "before:content-[''] before:absolute before:inset-0 before:pointer-events-none before:opacity-0",
          'before:bg-[radial-gradient(ellipse_at_20%_60%,oklch(0.62_0.13_196/0.07),transparent_70%)]',
          'before:transition-opacity before:duration-500 before:ease-out hover-fine:before:opacity-100',
          '*:relative *:z-1',
        ]}
      >
        <h3 class="font-heading font-normal text-ink text-[clamp(1.6rem,2.5vw,2.2rem)] tracking-[-0.5px] mb-3 transition-colors duration-300 ease-out group-hover:text-primary">{specialty.title}</h3>
        <p class="text-[0.98rem] font-light leading-[1.65] text-muted max-w-[380px] mb-5">{specialty.description}</p>
        <ul class="list-none p-0 mb-0 flex flex-col gap-[0.4rem]">
          {specialty.items.map((item) => (
            <li class="relative py-[0.55rem] border-b border-black/6 last:border-b-0 text-[0.9rem] font-light leading-[1.6] text-muted before:content-['–'] before:inline-block before:mr-[0.45em] before:text-primary before:opacity-60 before:font-normal">{item}</li>
          ))}
        </ul>
        <a
          href="/tratamientos"
          class="specialty-link inline-flex items-center gap-[0.45rem] mt-6 text-primary text-[0.84rem] font-normal no-underline opacity-0 translate-y-[6px] transition-[opacity,translate,gap] duration-250 ease-out group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:translate-y-0 hover-fine:gap-[0.8rem] [@media(hover:none)]:opacity-100 [@media(hover:none)]:translate-y-0"
        >Explorar tratamientos <span aria-hidden="true">→</span></a>
      </div>
    ))}
  </div>
</section>
