---
import NavMenu from './NavMenu';

interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
---

<!-- Navbar flotante de vidrio (liquid glass). El header solo posiciona; la
     cápsula es la que recibe eventos. El vidrio vive en .glass-layer (capa
     hermana) porque backdrop-filter en un ancestro rompería el menú móvil fijo. -->
<header class="pointer-events-none fixed inset-x-0 top-0 z-[1000] px-4 pt-4 transition-[padding] duration-300 ease-out md:px-6 scrolled:pt-3">
  <div class="pointer-events-auto relative isolate mx-auto flex max-w-[1240px] items-center justify-between rounded-full py-2 pr-2 pl-5 max-md:pl-4">
    <span
      aria-hidden="true"
      class="glass-layer glass absolute inset-0 -z-1 rounded-full transition-[background-color,border-color,box-shadow] duration-300 ease-out scrolled:glass-strong on-dark-hero:glass-dark"
    ></span>
    <a href="/" aria-label="Volver al inicio" class="block rounded-full">
      <img
        src="/img/logo_nav.webp"
        alt="Logotipo de Esteti'Kas"
        width="152"
        height="200"
        loading="eager"
        fetchpriority="high"
        class="block h-14 w-auto origin-left object-contain transition-transform duration-300 ease-out scrolled:scale-90 max-md:h-12"
      />
    </a>
    <NavMenu client:load isHome={isHome} />
  </div>
</header>

<script>
  // Estado "scrolled": vidrio más opaco y cápsula más compacta
  const header = document.querySelector('header');
  if (header) {
    const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 15);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
